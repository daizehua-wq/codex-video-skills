{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/broll_requests-3.0.json",
  "title": "B-roll Requests v3.0",
  "type": "object",
  "required": ["schema", "project", "requests", "execution_rules"],
  "properties": {
    "schema": {"const": "broll_requests/3.0"},
    "project": {
      "type": "object",
      "required": [
        "name", "runtime_sec", "timing_basis", "handoff_status", "aroll_readiness",
        "aspect_ratio", "style_profile", "visual_policy", "director_plan"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "runtime_sec": {"type": "number", "exclusiveMinimum": 0},
        "timing_basis": {"const": "measured"},
        "handoff_status": {"const": "execution_ready"},
        "aroll_readiness": {"$ref": "#/$defs/arollReadiness"},
        "aspect_ratio": {"type": "string", "minLength": 3},
        "style_profile": {"const": "comprehension-led-talking-head/3.0"},
        "visual_policy": {"const": "comprehension_led_no_quota"},
        "director_plan": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "segment_id", "sequence_position", "script_anchor", "coverage_window",
          "asset_class", "visual_role", "why_asset_needed", "required_assets",
          "preferred_sources", "forbidden_assets", "requested_media",
          "source_identity_region", "evidence_region", "crop_policy", "allowed_derivation",
          "coverage_duration_sec", "source_handles_sec", "priority", "fact_guardrails", "fallback"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^BR[0-9]{3,}$"},
          "segment_id": {"type": "string", "pattern": "^SEG[0-9]{3,}$"},
          "sequence_position": {"type": "integer", "minimum": 1},
          "script_anchor": {"type": "string", "minLength": 1},
          "coverage_window": {
            "type": "object",
            "required": ["start_sec", "end_sec", "timing_basis"],
            "properties": {
              "start_sec": {"type": "number", "minimum": 0},
              "end_sec": {"type": "number", "exclusiveMinimum": 0},
              "timing_basis": {"const": "measured"}
            },
            "additionalProperties": false
          },
          "asset_class": {
            "enum": [
              "source_page_screenshot", "source_document", "source_video",
              "product_ui_still", "product_demo_video", "real_scene", "source_backed_diagram"
            ]
          },
          "visual_role": {"enum": ["proof", "demonstration", "explanation", "orientation"]},
          "why_asset_needed": {"type": "string", "minLength": 1},
          "required_assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "preferred_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "forbidden_assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requested_media": {"enum": ["still", "video", "either"]},
          "source_identity_region": {"type": ["string", "null"]},
          "evidence_region": {"type": ["string", "null"]},
          "crop_policy": {"enum": ["raw_source_visible", "source_identity_then_detail", "full_frame_only"]},
          "allowed_derivation": {"enum": ["raw_only", "crop_highlight_only"]},
          "coverage_duration_sec": {"type": "number", "minimum": 0.5},
          "source_handles_sec": {
            "type": "object",
            "required": ["before", "after"],
            "properties": {
              "before": {"type": "number", "minimum": 0},
              "after": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          },
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "fact_guardrails": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "fallback": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "execution_rules": {
      "type": "object",
      "required": ["candidate_count_per_request", "source_priority", "default_reject", "output_required"],
      "properties": {
        "candidate_count_per_request": {
          "type": "object",
          "required": ["recommended", "alternates"],
          "properties": {
            "recommended": {"const": 1},
            "alternates": {"const": 2}
          },
          "additionalProperties": false
        },
        "source_priority": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "default_reject": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "output_required": {
          "type": "array",
          "minItems": 4,
          "allOf": [
            {"contains": {"const": "assets/"}},
            {"contains": {"const": "manifest.csv"}},
            {"contains": {"const": "manifest.json"}},
            {"contains": {"const": "sources.md"}}
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "arollReadiness": {
      "type": "object",
      "required": ["human_finalized", "media_file", "transcript_file", "duration_source", "checks", "notes"],
      "properties": {
        "human_finalized": {"const": true},
        "media_file": {"type": "string", "minLength": 1},
        "transcript_file": {"type": "string", "minLength": 1},
        "duration_source": {"const": "probed_media"},
        "checks": {
          "type": "object",
          "required": [
            "media_readable", "video_stream_present", "audio_stream_present",
            "duration_measured", "transcript_timecoded", "transcript_within_runtime",
            "human_lock_confirmed"
          ],
          "properties": {
            "media_readable": {"const": true},
            "video_stream_present": {"const": true},
            "audio_stream_present": {"const": true},
            "duration_measured": {"const": true},
            "transcript_timecoded": {"const": true},
            "transcript_within_runtime": {"const": true},
            "human_lock_confirmed": {"const": true}
          },
          "additionalProperties": false
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

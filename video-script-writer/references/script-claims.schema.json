{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video script semantic and claim handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "fact_card_path", "narration_path", "target",
    "narrative_beats", "structure", "duration_estimate", "claim_uses",
    "unmapped_assertions", "checks"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "fact_card_path": {"type": "string", "minLength": 1},
    "narration_path": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "duration_seconds", "timing_basis", "audience", "tone", "style_overrides"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": ["integer", "null"], "minimum": 1},
        "timing_basis": {"enum": ["estimated", "unspecified"]},
        "audience": {"type": "string"},
        "tone": {"type": "string"},
        "style_overrides": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "narrative_beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "statement_type", "exact_anchor", "fact_ids", "new_information", "leads_to"],
        "properties": {
          "id": {"type": "string", "pattern": "^SB-[0-9]{3,}$"},
          "role": {
            "enum": [
              "hook", "attribution", "context", "question", "promise", "evidence",
              "explanation", "contrast", "response", "case", "boundary", "judgment", "takeaway"
            ]
          },
          "statement_type": {
            "enum": ["fact", "attributed_fact", "interpretation", "question", "transition", "takeaway"]
          },
          "exact_anchor": {"type": "string", "minLength": 1},
          "fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}
          },
          "new_information": {"type": "string", "minLength": 1},
          "leads_to": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"statement_type": {"enum": ["fact", "attributed_fact"]}}},
            "then": {"properties": {"fact_ids": {"minItems": 1}}}
          }
        ]
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening", "ending"],
      "properties": {
        "opening": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tension_anchor", "source_anchor", "central_question_anchor", "viewing_promise_anchor"],
          "properties": {
            "tension_anchor": {"type": "string", "minLength": 1},
            "source_anchor": {"type": ["string", "null"]},
            "central_question_anchor": {"type": "string", "minLength": 1},
            "viewing_promise_anchor": {"type": "string", "minLength": 1}
          }
        },
        "ending": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opening_callback_anchor", "transferable_takeaway_anchor", "adds_new_factual_claims"],
          "properties": {
            "opening_callback_anchor": {"type": "string", "minLength": 1},
            "transferable_takeaway_anchor": {"type": "string", "minLength": 1},
            "adds_new_factual_claims": {"const": false}
          }
        }
      }
    },
    "duration_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_whitespace_chars", "assumed_chars_per_second", "estimated_duration_seconds", "target_delta_seconds"],
      "properties": {
        "non_whitespace_chars": {"type": "integer", "minimum": 1},
        "assumed_chars_per_second": {"type": "number", "exclusiveMinimum": 0},
        "estimated_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "target_delta_seconds": {"type": ["number", "null"]}
      }
    },
    "claim_uses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fact_ids", "exact_anchor", "use", "attribution_present", "scope_note"],
        "properties": {
          "id": {"type": "string", "pattern": "^SC-[0-9]{3,}$"},
          "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
          "exact_anchor": {"type": "string", "minLength": 1},
          "use": {"enum": ["direct", "paraphrase", "attributed", "quote"]},
          "attribution_present": {"type": "boolean"},
          "scope_note": {"type": "string"}
        }
      }
    },
    "unmapped_assertions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_factual_claims_mapped", "prohibited_claims_used", "quotes_verified",
        "numbers_verified", "scope_reviewed", "repetition_reviewed", "read_aloud_completed",
        "opening_promise_reviewed", "fact_interpretation_separated",
        "beat_progression_reviewed", "ending_closure_reviewed", "duration_reviewed"
      ],
      "properties": {
        "all_factual_claims_mapped": {"type": "boolean"},
        "prohibited_claims_used": {"type": "boolean"},
        "quotes_verified": {"type": "boolean"},
        "numbers_verified": {"type": "boolean"},
        "scope_reviewed": {"type": "boolean"},
        "repetition_reviewed": {"type": "boolean"},
        "read_aloud_completed": {"type": "boolean"},
        "opening_promise_reviewed": {"type": "boolean"},
        "fact_interpretation_separated": {"type": "boolean"},
        "beat_progression_reviewed": {"type": "boolean"},
        "ending_closure_reviewed": {"type": "boolean"},
        "duration_reviewed": {"type": "boolean"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video script semantic and claim handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "fact_card_path", "narration_path", "script_package_path",
    "editorial_design", "target", "narrative_beats", "structure", "duration_estimate",
    "hkrr_review", "claim_uses", "unmapped_assertions", "checks"
  ],
  "properties": {
    "schema_version": {"enum": ["1.2", "1.3"]},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "fact_card_path": {"type": "string", "minLength": 1},
    "narration_path": {"type": "string", "minLength": 1},
    "script_package_path": {"type": "string", "minLength": 1},
    "editorial_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_thesis", "core_question", "audience_relevance", "final_judgment", "logic_chain"],
      "properties": {
        "core_thesis": {"type": "string", "minLength": 1},
        "core_question": {"type": "string", "minLength": 1},
        "audience_relevance": {"type": "string", "minLength": 1},
        "final_judgment": {"type": "string", "minLength": 1},
        "selected_lesson_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^TL-[0-9]{3,}$"}
        },
        "audience_decision": {"type": "string", "minLength": 1},
        "logic_chain": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "duration_seconds", "timing_basis", "audience", "tone", "style_overrides"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": ["integer", "null"], "minimum": 1},
        "timing_basis": {"enum": ["estimated", "unspecified"]},
        "audience": {"type": "string"},
        "tone": {"type": "string"},
        "style_overrides": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "narrative_beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "statement_type", "exact_anchor", "fact_ids", "new_information", "leads_to"],
        "properties": {
          "id": {"type": "string", "pattern": "^SB-[0-9]{3,}$"},
          "role": {
            "enum": [
              "hook", "attribution", "context", "question", "promise", "evidence",
              "explanation", "contrast", "response", "case", "boundary", "judgment", "takeaway"
            ]
          },
          "statement_type": {
            "enum": ["fact", "attributed_fact", "interpretation", "question", "transition", "takeaway"]
          },
          "exact_anchor": {"type": "string", "minLength": 1},
          "fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}
          },
          "lesson_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^TL-[0-9]{3,}$"}
          },
          "new_information": {"type": "string", "minLength": 1},
          "leads_to": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"statement_type": {"enum": ["fact", "attributed_fact"]}}},
            "then": {"properties": {"fact_ids": {"minItems": 1}}}
          }
        ]
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening", "ending"],
      "properties": {
        "opening": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tension_anchor", "source_anchor", "central_question_anchor", "viewing_promise_anchor"],
          "properties": {
            "tension_anchor": {"type": "string", "minLength": 1},
            "source_anchor": {"type": ["string", "null"]},
            "central_question_anchor": {"type": "string", "minLength": 1},
            "viewing_promise_anchor": {"type": "string", "minLength": 1}
          }
        },
        "ending": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opening_callback_anchor", "transferable_takeaway_anchor", "adds_new_factual_claims"],
          "properties": {
            "opening_callback_anchor": {"type": "string", "minLength": 1},
            "transferable_takeaway_anchor": {"type": "string", "minLength": 1},
            "adds_new_factual_claims": {"const": false}
          }
        }
      }
    },
    "duration_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_whitespace_chars", "assumed_chars_per_second", "estimated_duration_seconds", "target_delta_seconds"],
      "properties": {
        "non_whitespace_chars": {"type": "integer", "minimum": 1},
        "assumed_chars_per_second": {"type": "number", "exclusiveMinimum": 0},
        "estimated_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "target_delta_seconds": {"type": ["number", "null"]}
      }
    },
    "hkrr_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_round", "dimensions", "weakest_dimensions", "thresholds_met",
        "recommend_further_revision", "revision_actions"
      ],
      "properties": {
        "review_round": {"type": "integer", "minimum": 1},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["H", "K", "R", "Rhythm"],
          "properties": {
            "H": {"$ref": "#/$defs/hkrrDimension"},
            "K": {"$ref": "#/$defs/hkrrDimension"},
            "R": {"$ref": "#/$defs/hkrrDimension"},
            "Rhythm": {"$ref": "#/$defs/hkrrDimension"}
          }
        },
        "weakest_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["H", "K", "R", "Rhythm"]}
        },
        "thresholds_met": {"type": "boolean"},
        "recommend_further_revision": {"type": "boolean"},
        "revision_actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_uses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fact_ids", "exact_anchor", "use", "attribution_present", "scope_note"],
        "properties": {
          "id": {"type": "string", "pattern": "^SC-[0-9]{3,}$"},
          "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
          "exact_anchor": {"type": "string", "minLength": 1},
          "use": {"enum": ["direct", "paraphrase", "attributed", "quote"]},
          "attribution_present": {"type": "boolean"},
          "scope_note": {"type": "string"}
        }
      }
    },
    "lesson_uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lesson_ids", "exact_anchor", "use", "conditions_preserved", "implementation_difficulty_preserved", "scope_note"],
        "properties": {
          "id": {"type": "string", "pattern": "^LU-[0-9]{3,}$"},
          "lesson_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TL-[0-9]{3,}$"}},
          "exact_anchor": {"type": "string", "minLength": 1},
          "use": {"enum": ["central_takeaway", "supporting_takeaway", "boundary", "implementation_path"]},
          "conditions_preserved": {"type": "boolean"},
          "implementation_difficulty_preserved": {"type": "boolean"},
          "scope_note": {"type": "string", "minLength": 1}
        }
      }
    },
    "unmapped_assertions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_factual_claims_mapped", "prohibited_claims_used", "quotes_verified",
        "numbers_verified", "scope_reviewed", "repetition_reviewed", "read_aloud_completed",
        "opening_promise_reviewed", "fact_interpretation_separated",
        "beat_progression_reviewed", "ending_closure_reviewed", "duration_reviewed",
        "core_thesis_locked", "writing_logic_reviewed", "hkrr_review_completed",
        "human_package_matches_narration"
      ],
      "properties": {
        "all_factual_claims_mapped": {"type": "boolean"},
        "prohibited_claims_used": {"type": "boolean"},
        "quotes_verified": {"type": "boolean"},
        "numbers_verified": {"type": "boolean"},
        "scope_reviewed": {"type": "boolean"},
        "repetition_reviewed": {"type": "boolean"},
        "read_aloud_completed": {"type": "boolean"},
        "opening_promise_reviewed": {"type": "boolean"},
        "fact_interpretation_separated": {"type": "boolean"},
        "beat_progression_reviewed": {"type": "boolean"},
        "ending_closure_reviewed": {"type": "boolean"},
        "duration_reviewed": {"type": "boolean"},
        "core_thesis_locked": {"type": "boolean"},
        "writing_logic_reviewed": {"type": "boolean"},
        "hkrr_review_completed": {"type": "boolean"},
        "human_package_matches_narration": {"type": "boolean"}
        ,"transferability_reviewed": {"type": "boolean"}
        ,"lesson_conditions_preserved": {"type": "boolean"}
        ,"implementation_difficulty_reviewed": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.3"}}},
      "then": {
        "required": ["lesson_uses"],
        "properties": {
          "editorial_design": {"required": ["selected_lesson_ids", "audience_decision"]},
          "checks": {"required": ["transferability_reviewed", "lesson_conditions_preserved", "implementation_difficulty_reviewed"]}
        }
      }
    }
  ],
  "$defs": {
    "hkrrDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "rationale"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}

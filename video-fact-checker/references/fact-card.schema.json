{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video fact card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "topic", "checked_at", "publication_status", "summary", "scope", "claims", "sources", "conflicts", "open_questions"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "topic": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date"},
    "publication_status": {"enum": ["pass", "conditional", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "event_overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "who", "what", "when", "where", "why", "how", "outcome", "notes"],
      "properties": {
        "applicable": {"type": "boolean"},
        "who": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "status", "supporting_claim_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "status": {"enum": ["supported", "partially_supported", "not_found", "not_applicable"]},
            "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}}
          }
        },
        "what": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "status", "supporting_claim_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "status": {"enum": ["supported", "partially_supported", "not_found", "not_applicable"]},
            "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}}
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "status", "supporting_claim_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "status": {"enum": ["supported", "partially_supported", "not_found", "not_applicable"]},
            "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}}
          }
        },
        "where": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "status", "supporting_claim_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "status": {"enum": ["supported", "partially_supported", "not_found", "not_applicable"]},
            "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}}
          }
        },
        "why": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "status", "supporting_claim_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "status": {"enum": ["supported", "partially_supported", "not_found", "not_applicable"]},
            "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}}
          }
        },
        "how": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "status", "supporting_claim_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "status": {"enum": ["supported", "partially_supported", "not_found", "not_applicable"]},
            "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}}
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "status", "supporting_claim_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "status": {"enum": ["supported", "partially_supported", "not_found", "not_applicable"]},
            "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}}
          }
        },
        "notes": {"type": "string"}
      }
    },
    "verification_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "temporal_search", "secondary_source_traces", "negative_claim_audits", "revision_audit"],
      "properties": {
        "mode": {"enum": ["initial", "revision"]},
        "temporal_search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "completed", "searched_through", "date_range", "official_domains", "notes"],
          "properties": {
            "applicable": {"type": "boolean"},
            "completed": {"type": "boolean"},
            "searched_through": {"type": "string", "format": "date"},
            "date_range": {"type": "string", "minLength": 1},
            "official_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "secondary_source_traces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "status", "upstream_source_ids", "notes"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
              "status": {"enum": ["traced", "unresolved", "not_applicable"]},
              "upstream_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"}},
              "notes": {"type": "string", "minLength": 1}
            }
          }
        },
        "negative_claim_audits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "finding_scope", "searched_source_ids", "searched_domains", "date_range", "upstream_trace_completed", "result_summary"],
            "properties": {
              "claim_id": {"type": "string", "pattern": "^FC-[0-9]{3,}$"},
              "finding_scope": {"enum": ["specified_source_only", "official_sources_checked", "broad_search_completed"]},
              "searched_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"}},
              "searched_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "date_range": {"type": "string", "minLength": 1},
              "upstream_trace_completed": {"type": "boolean"},
              "result_summary": {"type": "string", "minLength": 1}
            }
          }
        },
        "revision_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_artifact", "changed_claim_ids", "all_material_claims_rechecked", "notes"],
          "properties": {
            "base_artifact": {"type": ["string", "null"]},
            "changed_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
            "all_material_claims_rechecked": {"type": "boolean"},
            "notes": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "transferability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "central_question", "case_mechanism", "mechanism_claim_ids", "lessons", "overall_judgment", "open_questions"],
      "properties": {
        "applicable": {"type": "boolean"},
        "central_question": {"type": "string", "minLength": 1},
        "case_mechanism": {"type": "string", "minLength": 1},
        "mechanism_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "lesson", "evidence_layer", "supporting_claim_ids", "reasoning", "handoff_use", "applies_when", "fails_when", "non_reusable_elements", "implementation_difficulty", "difficulty_drivers", "minimum_viable_pilot", "evaluation_signals", "notes"],
            "properties": {
              "id": {"type": "string", "pattern": "^TL-[0-9]{3,}$"},
              "title": {"type": "string", "minLength": 1},
              "lesson": {"type": "string", "minLength": 1},
              "evidence_layer": {"enum": ["source_established", "bounded_synthesis", "implementation_hypothesis"]},
              "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
              "reasoning": {"type": "string", "minLength": 1},
              "handoff_use": {"enum": ["script_ready", "conditional", "context_only", "prohibited"]},
              "applies_when": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "fails_when": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "non_reusable_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "implementation_difficulty": {"enum": ["simple", "moderate", "complex", "unknown"]},
              "difficulty_drivers": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "minimum_viable_pilot": {"type": "string", "minLength": 1},
              "evaluation_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "notes": {"type": "string"}
            }
          }
        },
        "implementation_path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "nature", "summary", "assumptions", "blockers", "stages", "scale_gates", "risk_note"],
          "properties": {
            "status": {"enum": ["ready", "conditional", "insufficient_evidence", "not_applicable"]},
            "nature": {"const": "editorial_guidance"},
            "summary": {"type": "string", "minLength": 1},
            "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "objective", "actions", "supporting_lesson_ids", "supporting_claim_ids", "prerequisites", "human_control", "implementation_difficulty", "exit_criteria"],
                "properties": {
                  "id": {"type": "string", "pattern": "^IP-[0-9]{3,}$"},
                  "name": {"type": "string", "minLength": 1},
                  "objective": {"type": "string", "minLength": 1},
                  "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "supporting_lesson_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TL-[0-9]{3,}$"}},
                  "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
                  "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "human_control": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "implementation_difficulty": {"enum": ["simple", "moderate", "complex", "unknown"]},
                  "exit_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                }
              }
            },
            "scale_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "risk_note": {"type": "string", "minLength": 1}
          }
        },
        "overall_judgment": {"type": "string", "minLength": 1},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "claim_type", "verification_status", "confidence", "script_use", "attribution_text", "source_ids", "allowed_wording", "forbidden_wording", "scope_limitations", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^FC-[0-9]{3,}$"},
          "statement": {"type": "string", "minLength": 1},
          "claim_type": {"enum": ["event", "number", "quote", "identity", "chronology", "causality", "definition", "interpretation", "forecast"]},
          "verification_status": {"enum": ["independently_verified", "primary_source_confirmed", "attributed_claim", "secondary_only", "unverified", "disputed", "false"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "script_use": {"enum": ["direct", "attributed", "prohibited"]},
          "attribution_text": {"type": ["string", "null"]},
          "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"}},
          "allowed_wording": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "forbidden_wording": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "scope_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "url", "published_at", "accessed_at", "source_tier", "independence_group", "supports_claim_ids", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "published_at": {"type": ["string", "null"]},
          "accessed_at": {"type": "string", "format": "date"},
          "source_tier": {"enum": ["A_PRIMARY_OFFICIAL", "B_PRIMARY_ATTRIBUTED", "C_INDEPENDENT_SECONDARY", "D_OTHER_SECONDARY", "E_USER_SUPPLIED"]},
          "independence_group": {"type": "string", "minLength": 1},
          "supports_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
          "limitations": {"type": "string"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_ids", "description", "resolution", "publication_consequence"],
        "properties": {
          "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FC-[0-9]{3,}$"}},
          "description": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "minLength": 1},
          "publication_consequence": {"type": "string", "minLength": 1}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {"required": ["verification_audit"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {"required": ["verification_audit", "transferability"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.3"}}},
      "then": {
        "required": ["verification_audit", "transferability"],
        "properties": {
          "transferability": {"required": ["implementation_path"]}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.4"}}},
      "then": {
        "required": ["verification_audit", "event_overview", "transferability"],
        "properties": {
          "transferability": {"required": ["implementation_path"]}
        }
      }
    }
  ]
}
